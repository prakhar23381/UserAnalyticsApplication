PORT=4000
MONGODB_URI=mongodb://localhost:27017/causalfunnel
DASHBOARD_ORIGIN=http://localhost:3000
# Production on Render only: rate-limit by the header Render's edge overwrites
# with the client's address. Leave unset locally (clients could fake it).
# CLIENT_IP_HEADER=true-client-ip
# The visitor's country from the edge (Render sits behind Cloudflare). Leave unset locally.
# COUNTRY_HEADER=cf-ipcountry
